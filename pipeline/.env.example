# Copy to pipeline/.env and fill in. NEVER commit .env.
# From Meta app (after checklist): Graph API access token with instagram_business_content_publish
IG_ACCESS_TOKEN=
# The Instagram professional account's IG User ID (we'll fetch it together during token wiring)
IG_USER_ID=
# Supabase project for slide hosting (public bucket, files deleted after publish)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=insta-slides
